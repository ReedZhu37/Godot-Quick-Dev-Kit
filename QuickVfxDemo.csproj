<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- Compile every shipped C# module together; only VFX is enabled in the demo. -->
  <ItemGroup>
    <Compile Include="addons/quick_input/csharp/**/*.cs" />
    <Compile Include="addons/quick_audio_manager/csharp/**/*.cs" />
    <Compile Include="addons/quick_database/csharp/**/*.cs" />
    <Compile Include="addons/quick_vfx_manager/csharp/**/*.cs" />
    <Compile Include="addons/quick_level_kit/csharp/**/*.cs" />
  </ItemGroup>
</Project>
